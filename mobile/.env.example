# Which backend to use: development | staging | production.
# Set per build profile in eas.json. Defaults to "development" in dev builds
# and "production" in release builds.
EXPO_PUBLIC_APP_ENV=development

# Optional override for the API base URL.
# - iOS simulator: http://localhost:8585 (the default for development)
# - Physical device: use your Mac's LAN IP, e.g. http://192.168.1.20:8585
# - Android emulator: http://10.0.2.2:8585
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8585
