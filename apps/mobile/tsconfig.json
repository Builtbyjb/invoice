{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "types": ["jest", "node"],
        "paths": {
            "@/*": ["./src/*"],
            "@/assets/*": ["./assets/*"],
        },
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "../.expo/types/**/*.ts",
        "apps/mobile/expo-env.d.ts",
        "apps/mobile/.expo/types/**/*.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
    ],
}
