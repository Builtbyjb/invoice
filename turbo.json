{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "dev:ios": {
      "persistent": true,
      "cache": false
  },
  "dev:server": {
    "persistent": true,
    "cache": false
}
  }
}
